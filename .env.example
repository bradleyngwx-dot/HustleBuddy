# Copy this file to .env and replace the values as required

# PostgreSQL database settings
DB_NAME=hustlebuddy
DB_USER=postgres
DB_PASSWORD= #to add own DB password from postgreSQL
DB_HOST=localhost
DB_PORT=5432

# Gmail settings
#To be left untouched for now due to email being sent on terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hustlebuddy.local
